# Production values for `nub run deploy` (stage `prod`).
# Copy to `.env.prod` and fill in. Do not commit `.env.prod`.
#
# CORS_ORIGIN is the production website origin (scheme + host, no path).
# Production is https://crew.aleno.casa (Alchemy `domain` on the web Worker).
# PR previews use a generated .env.preview and pr-{n}.preview.aleno.casa.
CORS_ORIGIN=https://crew.aleno.casa
BETTER_AUTH_SECRET=replace-with-a-dedicated-production-secret
