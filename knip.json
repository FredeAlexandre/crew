{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"ignoreBinaries": ["nub", "nubx"],
	"ignoreDependencies": ["@cloudflare/workers-types", "@biomejs/biome", "cloudflare"],
	"workspaces": {
		".": {
			"entry": ["dependency-cruiser.mjs"]
		},
		"packages/engine": {
			"entry": ["playground/**/index.ts!"]
		},
		"packages/view-model": {
			"entry": ["playground/**/index.ts!"]
		}
	}
}
